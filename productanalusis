<script>
  // Filter chip toggle
  document.querySelectorAll('.filter-chip').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-chip').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    });
  });

  // Animate score bar on load
  window.addEventListener('load', () => {
    const bar = document.querySelector('.score-bar-fill');
    if (bar) { bar.style.width = '0'; setTimeout(() => { bar.style.width = '86%'; }, 300); }
    const sentBars = document.querySelectorAll('.sent-bar');
    sentBars.forEach((b, i) => {
      const w = b.style.width;
      b.style.width = '0';
      setTimeout(() => { b.style.width = w; b.style.transition = 'width 0.8s cubic-bezier(.4,0,.2,1)'; }, 400 + i * 100);
    });
  });
</script>

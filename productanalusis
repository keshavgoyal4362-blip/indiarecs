<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,400&display=swap" rel="stylesheet"/>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #0d0f12;
    --surface: #141720;
    --surface2: #1b1f2e;
    --border: rgba(255,255,255,0.07);
    --border2: rgba(255,255,255,0.12);
    --text: #e8eaf0;
    --muted: #7a8099;
    --accent-green: #22d77f;
    --accent-yellow: #f5c542;
    --accent-red: #f0574f;
    --accent-blue: #5b8df6;
    --positive: #22d77f;
    --neutral: #f5c542;
    --negative: #f0574f;
    --pro-color: #22d77f;
    --con-color: #f0574f;
    --radius: 14px;
    --radius-sm: 8px;
  }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    min-height: 100vh;
  }

  /* TOP BAR */
  .topbar {
    background: #0a0c0f;
    border-bottom: 1px solid var(--border);
    padding: 0 28px;
    display: flex;
    align-items: center;
    gap: 24px;
    height: 52px;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .logo {
    font-family: 'Sora', sans-serif;
    font-weight: 700;
    font-size: 16px;
    color: #fff;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .logo-flag { font-size: 20px; }
  .badge-beta {
    background: rgba(91,141,246,0.18);
    color: var(--accent-blue);
    font-size: 10px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 20px;
    border: 1px solid rgba(91,141,246,0.3);
  }
  .topbar-nav { display: flex; gap: 4px; margin-left: 12px; }
  .topbar-nav a {
    color: var(--muted);
    font-size: 13px;
    font-weight: 500;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: color .2s, background .2s;
  }
  .topbar-nav a:hover { color: var(--text); background: var(--border); }
  .topbar-search {
    margin-left: auto;
    background: var(--surface);
    border: 1px solid var(--border2);
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 12px;
    width: 220px;
    color: var(--muted);
    font-size: 13px;
    height: 34px;
  }
  .topbar-search input {
    background: none;
    border: none;
    outline: none;
    color: var(--text);
    font-family: inherit;
    font-size: 13px;
    width: 100%;
  }
  .topbar-search input::placeholder { color: var(--muted); }
  .topbar-trend {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
  }
  .topbar-trend:hover { color: var(--text); }

  /* BREADCRUMB */
  .breadcrumb {
    padding: 12px 28px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--muted);
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }
  .breadcrumb a { color: var(--muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--text); }
  .breadcrumb .sep { opacity: .4; }
  .breadcrumb .current { color: var(--text); }
  .bread-actions { margin-left: auto; display: flex; gap: 8px; }
  .bread-btn {
    display: flex;
    align-items: center;
    gap: 5px;
    background: var(--surface);
    border: 1px solid var(--border2);
    color: var(--text);
    font-family: inherit;
    font-size: 12px;
    font-weight: 500;
    padding: 5px 12px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background .2s;
  }
  .bread-btn:hover { background: var(--surface2); }

  /* PAGE WRAPPER */
  .page { padding: 24px 28px 48px; max-width: 1340px; margin: 0 auto; }

  /* HERO ROW */
  .hero { display: grid; grid-template-columns: 360px 1fr 260px; gap: 16px; margin-bottom: 16px; }

  .hero-image {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 240px;
    overflow: hidden;
    position: relative;
  }
  .hero-image img {
    max-width: 170px;
    max-height: 200px;
    object-fit: contain;
    filter: drop-shadow(0 8px 32px rgba(0,0,0,.5));
  }

  .hero-info {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .top-rated-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(34,215,127,0.12);
    border: 1px solid rgba(34,215,127,0.25);
    color: var(--accent-green);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .04em;
    padding: 4px 10px;
    border-radius: 20px;
    width: fit-content;
  }
  .hero-title {
    font-family: 'Sora', sans-serif;
    font-size: 26px;
    font-weight: 700;
    color: #fff;
    line-height: 1.2;
  }
  .hero-brand { color: var(--muted); font-size: 13px; margin-top: -6px; }
  .hero-tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .tag {
    background: var(--surface2);
    border: 1px solid var(--border2);
    color: var(--text);
    font-size: 12px;
    font-weight: 500;
    padding: 4px 10px;
    border-radius: 20px;
  }
  .hero-desc { color: #b0b8cc; font-size: 14px; line-height: 1.65; }
  .hero-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }
  .meta-reviews {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    color: var(--muted);
  }
  .dot-green { width: 8px; height: 8px; background: var(--accent-green); border-radius: 50%; flex-shrink: 0; }
  .meta-source {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    color: var(--muted);
  }
  .reddit-dot {
    width: 18px; height: 18px; background: #ff4500; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 10px; color: #fff; font-weight: 700;
  }

  .hero-score {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 8px;
  }
  .score-label { font-size: 13px; font-weight: 600; color: var(--muted); letter-spacing: .04em; text-transform: uppercase; }
  .score-number {
    font-family: 'Sora', sans-serif;
    font-size: 64px;
    font-weight: 700;
    color: var(--accent-green);
    line-height: 1;
    letter-spacing: -2px;
  }
  .score-sentiment { font-size: 15px; font-weight: 600; color: var(--accent-green); }
  .score-based { font-size: 12px; color: var(--muted); }
  .score-bar {
    width: 100%;
    height: 6px;
    background: var(--surface2);
    border-radius: 3px;
    margin-top: 4px;
    overflow: hidden;
  }
  .score-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent-green), #7ef4b8);
    border-radius: 3px;
    width: 86%;
    transition: width 1s cubic-bezier(.4,0,.2,1);
  }

  /* SECOND ROW */
  .second-row { display: grid; grid-template-columns: 240px 300px 1fr 1fr; gap: 16px; margin-bottom: 16px; }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
  }
  .card-title {
    font-family: 'Sora', sans-serif;
    font-size: 13px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 4px;
  }
  .card-sub { font-size: 11px; color: var(--muted); margin-bottom: 16px; }

  /* SENTIMENT BREAKDOWN */
  .sentiment-row { display: flex; flex-direction: column; gap: 12px; margin-bottom: 16px; }
  .sent-item { display: flex; align-items: center; gap: 10px; }
  .sent-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
  .sent-label { font-size: 13px; color: var(--text); width: 56px; }
  .sent-bar-wrap { flex: 1; height: 8px; background: var(--surface2); border-radius: 4px; overflow: hidden; }
  .sent-bar { height: 100%; border-radius: 4px; }
  .sent-pct { font-size: 12px; color: var(--muted); width: 44px; text-align: right; white-space: nowrap; }
  .sent-total { font-size: 12px; color: var(--muted); margin-top: 4px; }

  /* QUICK OVERVIEW */
  .overview-list { display: flex; flex-direction: column; gap: 8px; }
  .overview-item { display: flex; align-items: flex-start; gap: 8px; font-size: 13px; color: #c5c9d8; }
  .ov-icon { font-size: 14px; margin-top: 1px; flex-shrink: 0; }
  .ov-neg { color: #f0574f; }
  .ov-pos { color: #22d77f; }

  /* PROS / CONS */
  .pros-cons-list { display: flex; flex-direction: column; gap: 10px; }
  .pc-item { display: flex; flex-direction: column; gap: 2px; }
  .pc-label {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    font-weight: 600;
  }
  .pc-label.pro { color: var(--pro-color); }
  .pc-label.con { color: var(--con-color); }
  .pc-mentions { font-size: 11px; color: var(--muted); margin-left: 20px; }
  .view-all {
    font-size: 12px;
    color: var(--accent-blue);
    cursor: pointer;
    margin-top: 10px;
    display: inline-block;
    text-decoration: none;
  }
  .view-all:hover { text-decoration: underline; }

  /* REVIEWS ROW */
  .reviews-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }
  .reviews-header h2 {
    font-family: 'Sora', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #fff;
  }
  .reviews-header p { font-size: 12px; color: var(--muted); }
  .reviews-count { font-size: 13px; color: var(--muted); }
  .review-filters { display: flex; gap: 8px; align-items: center; }
  .filter-chip {
    display: flex;
    align-items: center;
    gap: 5px;
    background: var(--surface2);
    border: 1px solid var(--border2);
    color: var(--text);
    font-family: inherit;
    font-size: 12px;
    font-weight: 500;
    padding: 5px 12px;
    border-radius: 20px;
    cursor: pointer;
    transition: all .2s;
  }
  .filter-chip.active { background: rgba(34,215,127,0.12); border-color: rgba(34,215,127,0.3); color: var(--accent-green); }
  .filter-chip:hover { background: var(--surface2); }

  .reviews-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-bottom: 16px; }

  .review-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .rv-top { display: flex; align-items: center; justify-content: space-between; }
  .rv-source { display: flex; align-items: center; gap: 7px; font-size: 12px; color: var(--muted); }
  .rv-dot { width: 7px; height: 7px; border-radius: 50%; }
  .rv-sentiment {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .04em;
    padding: 3px 8px;
    border-radius: 20px;
  }
  .rv-sentiment.positive { background: rgba(34,215,127,0.14); color: var(--positive); }
  .rv-sentiment.neutral { background: rgba(245,197,66,0.14); color: var(--neutral); }
  .rv-sentiment.negative { background: rgba(240,87,79,0.14); color: var(--negative); }
  .rv-text { font-size: 13px; color: #b8bdd0; line-height: 1.6; }
  .rv-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .rv-tag {
    background: var(--surface2);
    border: 1px solid var(--border);
    color: var(--muted);
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 20px;
  }
  .rv-footer { display: flex; align-items: center; justify-content: space-between; margin-top: auto; }
  .rv-upvotes { font-size: 12px; color: var(--muted); display: flex; align-items: center; gap: 5px; }
  .rv-reply { font-size: 12px; color: var(--accent-blue); cursor: pointer; background: none; border: none; font-family: inherit; }
  .rv-reply:hover { text-decoration: underline; }

  /* RECOMMENDATIONS */
  .rec-section { margin-top: 16px; }
  .rec-title {
    font-family: 'Sora', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 14px;
  }
  .rec-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .rec-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
    display: flex;
    gap: 12px;
    cursor: pointer;
    transition: border-color .2s, background .2s;
  }
  .rec-card:hover { border-color: var(--border2); background: var(--surface2); }
  .rec-img {
    width: 52px;
    height: 52px;
    background: var(--surface2);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
  }
  .rec-info { flex: 1; min-width: 0; }
  .rec-name { font-size: 13px; font-weight: 600; color: var(--text); line-height: 1.3; margin-bottom: 4px; }
  .rec-reviews { font-size: 11px; color: var(--muted); }
  .star { color: var(--accent-yellow); font-size: 11px; }

  /* SCROLLBAR */
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: var(--surface2); border-radius: 3px; }

  /* ANIMATIONS */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .hero { animation: fadeUp .5s ease both; }
  .second-row { animation: fadeUp .5s .1s ease both; }
  .reviews-section { animation: fadeUp .5s .2s ease both; }
  .rec-section { animation: fadeUp .5s .3s ease both; }
</style>
</head>
